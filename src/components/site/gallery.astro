---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// Fetch gallery images ordered by the admin's number
const galleryImages = await sanityClient.fetch(`
  *[_type == "gallery"] | order(displayOrder asc) {
    title,
    "imageUrl": image.asset->url
  }
`);
---

<section id="gallery" class="bg-wolves-black px-8 py-20 md:py-24">
	<SectionHeading title="Club Gallery" subtitle="Moments of magic" />
	
    {/* UPDATED: Changed max-w-[87.5rem] to max-w-4xl to make the overall gallery window smaller */}
    <div class="mx-auto max-w-3xl">
        
        {/* Slider Container */}
        <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-wolves-gold/20 bg-wolves-dark-gray/50 shadow-2xl">
            
            {galleryImages.length > 0 ? (
                galleryImages.map((img: any, index: number) => (
                    <img 
                        src={img.imageUrl} 
                        alt={img.title} 
                        {/* UPDATED: Changed object-cover to object-contain so images shrink to fit perfectly */}
                        class={`gallery-slide absolute inset-0 h-full w-full object-contain transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                        loading={index === 0 ? "eager" : "lazy"}
                    />
                ))
            ) : (
                <div class="flex h-full w-full items-center justify-center text-white/50">
                    Images coming soon...
                </div>
            )}

        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.gallery-slide');
        if (slides.length <= 1) return; // No need to slide if 0 or 1 image

        let currentSlide = 0;

        // Change slide every 10,000 milliseconds (10 seconds)
        setInterval(() => {
            // Fade out current
            slides[currentSlide].classList.remove('opacity-100', 'z-10');
            slides[currentSlide].classList.add('opacity-0', 'z-0');

            // Move to next slide (and loop back to 0 at the end)
            currentSlide = (currentSlide + 1) % slides.length;

            // Fade in next
            slides[currentSlide].classList.remove('opacity-0', 'z-0');
            slides[currentSlide].classList.add('opacity-100', 'z-10');
        }, 10000);
    });
</script>