---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// 1. UPDATED QUERY: Fetch the sliderSpeed from Sanity
const allTeams = await sanityClient.fetch(`
  *[_type == "team"] | order(displayOrder asc) {
    teamName,
    category,
    subtitle,
    sliderSpeed,
    "imageUrls": images[].asset->url,
    details
  }
`);

// Group the flat Sanity data into the structured array your layout expects
const groups = [
	{
		heading: 'Executive Members',
		teams: allTeams.filter((t: any) => t.category === 'Executive Members'),
	},
	{
		heading: 'Senior Teams',
		teams: allTeams.filter((t: any) => t.category === 'Senior Teams'),
	},
	{
		heading: 'Junior Teams',
		teams: allTeams.filter((t: any) => t.category === 'Junior Teams'),
	},
].filter((group) => group.teams.length > 0);
---

<section id="teams" class="bg-wolves-dark-gray px-8 py-20 md:py-24">
	<SectionHeading title="Our Teams" />
	{
		groups.map((group) => (
			<div class="mx-auto mb-16 max-w-[87.5rem] last:mb-0">
				<h3 class="font-oswald mb-8 text-center text-2xl font-bold uppercase tracking-widest text-wolves-gold">
					{group.heading}
				</h3>
				<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
					{group.teams.map((team: any) => (
						<div class="flex flex-row items-start justify-between gap-6 rounded-xl border-l-4 border-wolves-gold bg-wolves-black p-8 transition-all duration-300 hover:translate-x-2 hover:border-l-8">
                            
                            <div class="flex-1">
							    <h4 class="font-oswald mb-4 text-2xl font-bold uppercase tracking-widest">{team.teamName}</h4>
							
                                {team.subtitle && (
                                    <p class="mb-3 font-semibold text-wolves-gold">{team.subtitle}</p>
                                )}
                                
							    <div
								    class="text-sm leading-relaxed text-white/70 [&_strong]:text-white/90"
								    set:html={team.details ? team.details.replace(/\n/g, '<br />') : ''}
							    />
                            </div>

                            {/* TEAM IMAGE SLIDER WITH LIGHTBOX TRIGGER */}
                            {team.imageUrls && team.imageUrls.length > 0 && (
                                <div 
                                    class="team-slider relative h-40 w-28 shrink-0 overflow-hidden rounded-lg border border-wolves-gold/20 shadow-lg"
                                    data-speed={team.sliderSpeed ? team.sliderSpeed * 1000 : 10000}
                                >
                                    {/* 2. UPDATED HTML: Moved the comment safely inside the div! */}
                                    {team.imageUrls.map((url: string, index: number) => (
                                        <img 
                                            src={url} 
                                            alt={team.teamName} 
                                            class={`team-slide absolute inset-0 h-full w-full object-cover cursor-pointer transition-transform transition-opacity duration-1000 ease-in-out hover:scale-105 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                                            onclick={`openTeamModal('${url}')`}
                                            loading={index === 0 ? "eager" : "lazy"} 
                                        />
                                    ))}
                                </div>
                            )}
						</div>
					))}
				</div>
			</div>
		))
	}

    {/* TEAMS IMAGE LIGHTBOX MODAL */}
    <div 
    	id="teamModal" 
    	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-wolves-black/95 p-4 opacity-0 transition-opacity duration-300"
	>
        <button 
       		onclick="closeTeamModal()" 
       		class="absolute right-6 top-6 text-5xl text-wolves-gold transition-transform hover:scale-110 hover:text-white focus:outline-none"
      		aria-label="Close modal"
   		>
        	&times;
        </button>
    	<img 
        	id="teamModalImage" 
        	src="" 
        	alt="Enlarged view" 
        	class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-[0_0_50px_rgba(0,0,0,0.5)]" 
    	/>
	</div>
</section>

<script is:inline>
    // --- MODAL LOGIC ---
    const tmModal = document.getElementById('teamModal');
    const tmModalImg = document.getElementById('teamModalImage');

    function openTeamModal(imgSrc) {
        tmModalImg.src = imgSrc;
        tmModal.classList.remove('hidden');
        tmModal.classList.add('flex');
        
        setTimeout(() => {
            tmModal.classList.remove('opacity-0');
            tmModal.classList.add('opacity-100');
        }, 10);
        
        document.body.style.overflow = 'hidden';
    }

    function closeTeamModal() {
        tmModal.classList.remove('opacity-100');
        tmModal.classList.add('opacity-0');
        
        setTimeout(() => {
            tmModal.classList.add('hidden');
            tmModal.classList.remove('flex');
            tmModalImg.src = ''; 
        }, 300);
        
        document.body.style.overflow = '';
    }

    if (tmModal) {
        tmModal.addEventListener('click', (e) => {
            if (e.target === tmModal) closeTeamModal();
        });
    }
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && tmModal && !tmModal.classList.contains('hidden')) {
            closeTeamModal();
        }
    });

    // --- SLIDESHOW LOGIC ---
    document.addEventListener('DOMContentLoaded', () => {
        const sliders = document.querySelectorAll('.team-slider');
        
        sliders.forEach(slider => {
            const slides = slider.querySelectorAll('.team-slide');
            if (slides.length <= 1) return; 

            let currentSlide = 0;
            
            // 3. UPDATED SCRIPT: Dynamically grab the specific speed for THIS slider
            const speed = parseInt(slider.getAttribute('data-speed')) || 10000;
            
            setInterval(() => {
                slides[currentSlide].classList.remove('opacity-100', 'z-10');
                slides[currentSlide].classList.add('opacity-0', 'z-0');
                
                currentSlide = (currentSlide + 1) % slides.length;
                
                slides[currentSlide].classList.remove('opacity-0', 'z-0');
                slides[currentSlide].classList.add('opacity-100', 'z-10');
            }, speed); 
        });
    });
</script>