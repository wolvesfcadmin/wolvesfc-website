---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// Fetch gallery images ordered by the admin's number
const galleryImages = await sanityClient.fetch(`
  *[_type == "gallery"] | order(displayOrder asc) {
    title,
    "imageUrl": image.asset->url
  }
`);
---

<section id="gallery" class="bg-wolves-black px-8 py-20 md:py-24">
	<SectionHeading title="Club Gallery" subtitle="Moments of magic" />
	
    <div class="mx-auto max-w-4xl">
        
        {/* Slider Container */}
        <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-wolves-gold/20 bg-wolves-dark-gray/50 shadow-2xl group">
            
            {/* Images */}
            {galleryImages.length > 0 ? (
                galleryImages.map((img: any, index: number) => (
                    <img 
                        src={img.imageUrl} 
                        alt={img.title} 
                        class={`gallery-slide absolute inset-0 h-full w-full object-contain transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                        loading={index === 0 ? "eager" : "lazy"}
                    />
                ))
            ) : (
                <div class="flex h-full w-full items-center justify-center text-white/50">
                    Images coming soon...
                </div>
            )}

            {/* Navigation Buttons (Only render if there is more than 1 image) */}
            {galleryImages.length > 1 && (
                <>
                    <button
                        id="prevBtn"
                        class="absolute left-4 top-1/2 z-20 -translate-y-1/2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-wolves-black/60 text-xl text-white backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:bg-wolves-gold hover:text-wolves-black focus:outline-none opacity-0 group-hover:opacity-100 md:opacity-100"
                        aria-label="Previous image"
                    >
                        &#10094;
                    </button>
                    <button
                        id="nextBtn"
                        class="absolute right-4 top-1/2 z-20 -translate-y-1/2 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-wolves-black/60 text-xl text-white backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:bg-wolves-gold hover:text-wolves-black focus:outline-none opacity-0 group-hover:opacity-100 md:opacity-100"
                        aria-label="Next image"
                    >
                        &#10095;
                    </button>
                </>
            )}

        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.gallery-slide');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        
        if (slides.length <= 1) return; // No need to slide or run logic if 0 or 1 image

        let currentSlide = 0;
        let slideInterval;
        const intervalTime = 10000; // 10 seconds

        // Reusable function to switch to a specific slide
        function showSlide(index) {
            // Fade out current
            slides[currentSlide].classList.remove('opacity-100', 'z-10');
            slides[currentSlide].classList.add('opacity-0', 'z-0');

            // Update index
            currentSlide = index;

            // Fade in new
            slides[currentSlide].classList.remove('opacity-0', 'z-0');
            slides[currentSlide].classList.add('opacity-100', 'z-10');
        }

        // Logic for next and previous
        function nextSlide() {
            let nextIndex = (currentSlide + 1) % slides.length;
            showSlide(nextIndex);
            resetInterval(); // Restart the clock so it doesn't double-skip
        }

        function prevSlide() {
            let prevIndex = (currentSlide - 1 + slides.length) % slides.length;
            showSlide(prevIndex);
            resetInterval(); // Restart the clock so it doesn't double-skip
        }

        // Timer management
        function startInterval() {
            slideInterval = setInterval(nextSlide, intervalTime);
        }

        function resetInterval() {
            clearInterval(slideInterval);
            startInterval();
        }

        // Event Listeners
        if (nextBtn) nextBtn.addEventListener('click', nextSlide);
        if (prevBtn) prevBtn.addEventListener('click', prevSlide);

        // Start the automatic slideshow on load
        startInterval();
    });
</script>