---
import { sanityClient } from '../../lib/sanity';

// Fetch the single Footer document
const footerData = await sanityClient.fetch(`
  *[_type == "footer"][0] {
    phone,
    email,
    physicalAddress,
    registeredAddress,
    socials,
    trainingTimes,
    copyrightText
  }
`);

// Fallback data so the site looks perfect before you fill out Sanity
const data = footerData || {
    phone: '082 437 5842',
    email: 'wolvesfcct60@gmail.com',
    physicalAddress: '📍 Chukker Road Sports Complex\nWetton, Cape Town',
    registeredAddress: 'Registered address (correspondence): 6 Haring Road, Strandfontein, Cape Town 7798, South Africa — per club governance documents.',
    socials: [
        { platform: 'Facebook', url: 'https://www.facebook.com/groups/28898039139' },
        { platform: 'Instagram', url: 'https://www.instagram.com/wolverhampton_capetown_fc/' },
        { platform: 'TikTok', url: 'https://www.tiktok.com/@wolverhampton.cpt' }
    ],
    trainingTimes: [
        { group: 'Seniors', times: 'Tues & Thurs 18:30' },
        { group: 'Juniors', times: 'Mon & Wed 17:00' }
    ],
    copyrightText: '2026 Wolverhampton Sports Club Cape Town. All rights reserved.'
};
---

<footer id="contact" class="border-t-2 border-wolves-gold bg-wolves-black px-8 pb-8 pt-16">
	<div class="mx-auto mb-12 grid max-w-[87.5rem] gap-12 md:grid-cols-2 lg:grid-cols-4">
		<div>
			<h3 class="font-oswald mb-6 text-lg uppercase tracking-widest text-wolves-gold">Contact Us</h3>
			<p class="mb-2 text-white/70">📞 {data.phone}</p>
			<p class="mb-2 text-white/70">✉️ {data.email}</p>
			<p 
    			class="text-white/70"
    			set:html={data.physicalAddress ? `📍 ${data.physicalAddress.replace(/\n/g, '<br />')}` : ''}
			/>
			<p class="mt-4 text-sm text-white/50">
				{data.registeredAddress}
			</p>
		</div>
		<div>
			<h3 class="font-oswald mb-6 text-lg uppercase tracking-widest text-wolves-gold">Quick Links</h3>
			<a class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold" href="#teams">Teams</a>
			<a class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold" href="#news">Latest News</a>
			<a class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold" href="#matches">Match Hub</a>
			<a class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold" href="#history">Club History</a>
			<a class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold" href="#register">Online Registration</a>
		</div>
		<div>
			<h3 class="font-oswald mb-6 text-lg uppercase tracking-widest text-wolves-gold">Follow Us</h3>
            {data.socials && data.socials.map((social: any) => (
			    <a
				    class="mb-2 block text-white/70 no-underline transition-colors hover:text-wolves-gold"
				    href={social.url}
				    target="_blank"
				    rel="noopener noreferrer"
                >
                    {social.platform}
                </a>
            ))}
		</div>
		<div>
			<h3 class="font-oswald mb-6 text-lg uppercase tracking-widest text-wolves-gold">Training Times</h3>
            
            {data.trainingTimes && data.trainingTimes.map((time: any) => (
			    <p class="mb-2 text-white/70"><strong>{time.group}:</strong> {time.times}</p>
            ))}
			
            <br />
			<div class="cdfa-affiliation">
                <img src="/cdfa-logo.png" width="120" height="55" alt="CDFA Logo" loading="eager" />
                <span>Affiliated to Cape District<br>Football Association</span>
            </div>
		</div>
	</div>

    {/* UPDATED BOTTOM BAR: Flexbox layout for copyright and developer credit */}
	<div class="mx-auto flex max-w-[87.5rem] flex-col items-center justify-between gap-4 border-t border-wolves-gold/20 pt-8 text-sm text-white/50 md:flex-row">
		<p>&copy; {data.copyrightText}
			<a 
                href="https://safacapetown.com/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="transition-transform duration-300 hover:scale-105"
                aria-label="SAFA Cape Town"
            >
		    	<img 
                    src="/pic_safa.jpg" 
                    alt="SAFA Cape Town" 
                    class="h-15 w-auto object-contain" 
                    loading="lazy" 
            	/>
			</a>
		</p>
        
        <div class="flex items-center gap-3">
            <span>Developed by:</span>
            <a 
                href="https://www.slick-it-solutions.com/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="transition-transform duration-300 hover:scale-105"
                aria-label="Developed by Slick IT Solutions"
            >
                <img 
                    src="/slick-logo.png" 
                    alt="Slick IT Solutions Logo" 
                    class="h-8 w-auto object-contain" 
                    loading="lazy" 
                />
            </a>
        </div>
	</div>
</footer>

<style>
    .cdfa-affiliation {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .cdfa-affiliation span {
        font-family: 'Bebas Neue', cursive;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: 1px;
        line-height: 1.2;
    }
</style>