---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// Fetch impact blocks, now pulling an array of image URLs
const impactBlocks = await sanityClient.fetch(`
  *[_type == "impact"] | order(displayOrder asc) {
    title,
    content,
    "imageUrls": images[].asset->url
  }
`);
---

<section id="impact" class="bg-wolves-black px-8 py-20 md:py-24">
	<SectionHeading title="Our Impact" subtitle="Community first" />
	
    <div class="mx-auto max-w-[87.5rem] space-y-12 text-lg leading-relaxed text-white/85">
        {impactBlocks.map((block: any) => (
            <div class="flex flex-col items-center gap-8 rounded-2xl border border-wolves-gold/20 bg-wolves-dark-gray/40 p-8 md:flex-row md:items-start md:p-10 lg:gap-12">
                {/* UPDATED: Added Flexbox classes to control the side-by-side layout */}
                
                {/* LEFT SIDE: Heading and Text */}
                <div class="flex-1 w-full">
                    <h3 class="font-oswald mb-4 text-xl font-bold uppercase tracking-widest text-wolves-gold">
                        {block.title}
                    </h3>
                    <div 
                        class="leading-relaxed"
                        set:html={block.content ? block.content.replace(/\n/g, '<br />') : ''}
                    />
                </div>

                {/* RIGHT SIDE: Image Slider */}
                {block.imageUrls && block.imageUrls.length > 0 && (
                    <div class="flex-1 w-full">
                        <div class="impact-slider relative aspect-video w-full overflow-hidden rounded-2xl border border-wolves-gold/20 bg-wolves-dark-gray/50 shadow-2xl">
                            {block.imageUrls.map((url: string, index: number) => (
                                <img 
                                    src={url} 
                                    alt={block.title} 
                                    class={`impact-slide absolute inset-0 h-full w-full object-contain cursor-pointer transition-transform transition-opacity duration-1000 ease-in-out hover:scale-[1.02] ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                                    onclick={`openImpactModal('${url}')`}
                                    loading={index === 0 ? "eager" : "lazy"}
                                />
                            ))}
                        </div>
                    </div>
                )}
            </div>
        ))}
	</div>

    {/* IMPACT IMAGE LIGHTBOX MODAL */}
    <div 
    	id="impactModal" 
    	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-wolves-black/95 p-4 opacity-0 transition-opacity duration-300"
	>
        <button 
       		onclick="closeImpactModal()" 
       		class="absolute right-6 top-6 text-5xl text-wolves-gold transition-transform hover:scale-110 hover:text-white focus:outline-none"
      		aria-label="Close modal"
   		>
        	&times;
        </button>
    	<img 
        	id="impactModalImage" 
        	src="" 
        	alt="Enlarged view" 
        	class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-[0_0_50px_rgba(0,0,0,0.5)]" 
    	/>
	</div>
</section>

<script is:inline>
    // --- MODAL LOGIC ---
    const impModal = document.getElementById('impactModal');
    const impModalImg = document.getElementById('impactModalImage');

    function openImpactModal(imgSrc) {
        impModalImg.src = imgSrc;
        impModal.classList.remove('hidden');
        impModal.classList.add('flex');
        
        setTimeout(() => {
            impModal.classList.remove('opacity-0');
            impModal.classList.add('opacity-100');
        }, 10);
        
        document.body.style.overflow = 'hidden';
    }

    function closeImpactModal() {
        impModal.classList.remove('opacity-100');
        impModal.classList.add('opacity-0');
        
        setTimeout(() => {
            impModal.classList.add('hidden');
            impModal.classList.remove('flex');
            impModalImg.src = ''; 
        }, 300);
        
        document.body.style.overflow = '';
    }

    if (impModal) {
        impModal.addEventListener('click', (e) => {
            if (e.target === impModal) closeImpactModal();
        });
    }
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && impModal && !impModal.classList.contains('hidden')) {
            closeImpactModal();
        }
    });

    // --- SLIDESHOW LOGIC ---
    document.addEventListener('DOMContentLoaded', () => {
        // Find every impact slider on the page separately
        const sliders = document.querySelectorAll('.impact-slider');
        
        sliders.forEach(slider => {
            const slides = slider.querySelectorAll('.impact-slide');
            if (slides.length <= 1) return; // Do nothing if there's only 1 image

            let currentSlide = 0;
            
            // Set 10-second interval isolated to this specific slider block
            setInterval(() => {
                slides[currentSlide].classList.remove('opacity-100', 'z-10');
                slides[currentSlide].classList.add('opacity-0', 'z-0');
                
                currentSlide = (currentSlide + 1) % slides.length;
                
                slides[currentSlide].classList.remove('opacity-0', 'z-0');
                slides[currentSlide].classList.add('opacity-100', 'z-10');
            }, 10000);
        });
    });
</script>