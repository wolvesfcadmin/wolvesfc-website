---
import { sanityClient } from '../../lib/sanity';

// Fetch the single CTA document, now including the image URL
const ctaData = await sanityClient.fetch(`
  *[_type == "joinCta"][0] {
    heading,
    description,
    "buttons": buttons[]{
      label,
      actionType,
      url,
      modalContent,
      "imageUrl": modalImage.asset->url
    }
  }
`);

const data = ctaData || {
    heading: 'Join The Pack',
    description: 'Ready to be part of a winning tradition? Register now for the 2026 season and experience what it means to be a Wolverhampton player.',
    buttons: [
        { label: 'Membership Form', actionType: 'link', url: '#' },
        { label: 'Membership Fees', actionType: 'modal', modalContent: 'Placeholder fee info...' },
        { label: 'Club 100', actionType: 'modal', modalContent: 'Placeholder Club 100 info...' }
    ]
};
---

<section id="register" class="bg-gradient-to-br from-wolves-gold to-wolves-orange px-8 py-20 text-center md:py-24">
	<div class="mx-auto max-w-3xl">
		<h2 class="font-bebas mb-6 text-4xl tracking-widest text-wolves-black md:text-6xl">
            {data.heading}
        </h2>
		<p class="mb-10 text-xl text-wolves-black/90">
			{data.description}
		</p>
		<div class="flex flex-col flex-wrap items-center justify-center gap-4 sm:flex-row">
            
            {data.buttons && data.buttons.map((btn: any) => {
                
                // 1. Render a button that triggers a TEXT modal
                if (btn.actionType === 'modal') {
                    return (
                        <button
                            data-title={btn.label}
                            data-content={btn.modalContent ? btn.modalContent.replace(/\n/g, '<br />') : ''}
                            onclick="openCtaModal(this)"
                            class="inline-block cursor-pointer rounded-full bg-wolves-black px-10 py-4 font-oswald text-base font-semibold uppercase tracking-widest text-white shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(0,0,0,0.4)] focus:outline-none"
                        >
                            {btn.label}
                        </button>
                    )
                } 
                
                // 2. Render a button that triggers an IMAGE modal
                else if (btn.actionType === 'image') {
                    return (
                        <button
                            data-img={btn.imageUrl}
                            onclick="openCtaImageModal(this)"
                            class="inline-block cursor-pointer rounded-full bg-wolves-black px-10 py-4 font-oswald text-base font-semibold uppercase tracking-widest text-white shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(0,0,0,0.4)] focus:outline-none"
                        >
                            {btn.label}
                        </button>
                    )
                }
                
                // 3. Otherwise, render a standard URL link
                else {
                    return (
                        <a
                            href={btn.url || '#'}
                            target={btn.url && btn.url.startsWith('http') ? '_blank' : '_self'}
                            rel="noopener noreferrer"
                            class="inline-block rounded-full bg-wolves-black px-10 py-4 font-oswald text-base font-semibold uppercase tracking-widest text-white no-underline shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(0,0,0,0.4)]"
                        >
                            {btn.label}
                        </a>
                    )
                }
            })}

		</div>
	</div>

    {/* TEXT LIGHTBOX MODAL */}
    <div 
    	id="ctaModal" 
    	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-wolves-black/95 p-4 text-left opacity-0 transition-opacity duration-300"
	>
        <div class="relative w-full max-w-2xl max-h-[85vh] overflow-y-auto rounded-2xl border border-wolves-gold/20 bg-wolves-dark-gray p-8 shadow-2xl md:p-12">
            <button 
                onclick="closeCtaModal()" 
                class="absolute right-6 top-6 text-4xl text-wolves-gold transition-transform hover:scale-110 hover:text-white focus:outline-none"
                aria-label="Close modal"
            >
                &times;
            </button>
            <h3 id="ctaModalTitle" class="font-oswald mb-6 pr-8 text-3xl font-bold uppercase tracking-widest text-wolves-gold"></h3>
            <div id="ctaModalContent" class="text-lg leading-relaxed text-white/85 [&_strong]:text-wolves-gold"></div>
        </div>
	</div>

    {/* IMAGE LIGHTBOX MODAL */}
    <div 
    	id="ctaImgModal" 
    	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-wolves-black/95 p-4 opacity-0 transition-opacity duration-300"
	>
        <button 
       		onclick="closeCtaImageModal()" 
       		class="absolute right-6 top-6 text-5xl text-wolves-gold transition-transform hover:scale-110 hover:text-white focus:outline-none"
      		aria-label="Close modal"
   		>
        	&times;
        </button>
    	<img 
        	id="ctaImgModalTarget" 
        	src="" 
        	alt="Enlarged view" 
        	class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-[0_0_50px_rgba(0,0,0,0.5)]" 
    	/>
	</div>
</section>

<script is:inline>
    // --- TEXT MODAL LOGIC ---
    const cModal = document.getElementById('ctaModal');
    const cModalTitle = document.getElementById('ctaModalTitle');
    const cModalContent = document.getElementById('ctaModalContent');

    function openCtaModal(element) {
        const title = element.getAttribute('data-title');
        const content = element.getAttribute('data-content');
        
        cModalTitle.innerText = title;
        cModalContent.innerHTML = content;
        
        cModal.classList.remove('hidden');
        cModal.classList.add('flex');
        
        setTimeout(() => {
            cModal.classList.remove('opacity-0');
            cModal.classList.add('opacity-100');
        }, 10);
        
        document.body.style.overflow = 'hidden';
    }

    function closeCtaModal() {
        cModal.classList.remove('opacity-100');
        cModal.classList.add('opacity-0');
        
        setTimeout(() => {
            cModal.classList.add('hidden');
            cModal.classList.remove('flex');
            cModalTitle.innerText = ''; 
            cModalContent.innerHTML = ''; 
        }, 300);
        
        document.body.style.overflow = '';
    }

    if (cModal) {
        cModal.addEventListener('click', (e) => {
            if (e.target === cModal) closeCtaModal();
        });
    }

    // --- IMAGE MODAL LOGIC ---
    const cImgModal = document.getElementById('ctaImgModal');
    const cImgModalTarget = document.getElementById('ctaImgModalTarget');

    function openCtaImageModal(element) {
        const imgSrc = element.getAttribute('data-img');
        if(!imgSrc) return; // Fail gracefully if no image is uploaded yet
        
        cImgModalTarget.src = imgSrc;
        cImgModal.classList.remove('hidden');
        cImgModal.classList.add('flex');
        
        setTimeout(() => {
            cImgModal.classList.remove('opacity-0');
            cImgModal.classList.add('opacity-100');
        }, 10);
        
        document.body.style.overflow = 'hidden';
    }

    function closeCtaImageModal() {
        cImgModal.classList.remove('opacity-100');
        cImgModal.classList.add('opacity-0');
        
        setTimeout(() => {
            cImgModal.classList.add('hidden');
            cImgModal.classList.remove('flex');
            cImgModalTarget.src = ''; 
        }, 300);
        
        document.body.style.overflow = '';
    }

    if (cImgModal) {
        cImgModal.addEventListener('click', (e) => {
            if (e.target === cImgModal) closeCtaImageModal();
        });
    }
    
    // --- GLOBAL ESCAPE KEY LOGIC ---
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            if (cModal && !cModal.classList.contains('hidden')) closeCtaModal();
            if (cImgModal && !cImgModal.classList.contains('hidden')) closeCtaImageModal();
        }
    });
</script>