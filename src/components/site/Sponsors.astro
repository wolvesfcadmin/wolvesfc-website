---
import { sanityClient } from '../../lib/sanity';
import { fundingPriorities, trustRegistration } from '../../data/fundingPriorities';
import SectionHeading from './SectionHeading.astro';

// Fetch the sponsors directly from Sanity
const sponsors = await sanityClient.fetch(`
  *[_type == "sponsor"] | order(companyName asc) {
    companyName,
    website,
    tier,
    "logoUrl": logo.asset->url
  }
`);
---

<section id="sponsors" class="bg-wolves-black px-8 py-20 md:py-24">
	<SectionHeading title="Our Sponsors" subtitle="Proud Partners" />
	
    <div class="mx-auto grid max-w-[87.5rem] grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
		{
			sponsors.map((s) => (
				<a
					href={s.website}
					target="_blank"
					rel="noopener noreferrer"
					class="group flex min-h-[150px] flex-col items-center justify-center rounded-xl border border-wolves-gold/10 bg-wolves-dark-gray p-10 text-center text-inherit no-underline transition-all duration-300 hover:-translate-y-2 hover:border-wolves-gold hover:shadow-[0_15px_40px_rgba(253,185,19,0.2)]"
				>
                    {s.logoUrl && (
                        <img
                            src={s.logoUrl}
                            alt={s.companyName}
                            class="mb-4 max-h-20 w-full max-w-full object-contain grayscale brightness-0 invert transition-[filter] duration-300 group-hover:grayscale-0 group-hover:brightness-100 group-hover:invert-0"
                            loading="lazy"
                        />
                    )}
                    {!s.logoUrl && (
                        <div class="mb-4 font-oswald text-lg font-bold text-white">{s.companyName}</div>
                    )}
					<span class="font-oswald text-sm font-semibold uppercase tracking-wide text-wolves-gold">
						{s.tier}
					</span>
				</a>
			))
		}
	</div>

	<div
		class="mx-auto mt-16 max-w-[87.5rem] overflow-hidden rounded-xl border-2 border-wolves-gold bg-gradient-to-br from-wolves-gold/10 to-wolves-orange/10"
	>
		<div
			class="flex flex-col gap-4 border-b border-wolves-gold/30 bg-wolves-black/40 px-6 py-5 text-center md:flex-row md:items-center md:justify-center md:gap-10 md:text-left"
		>
			<p class="font-oswald text-sm font-bold uppercase tracking-widest text-wolves-gold">
				Registered non-profit & tax-exempt
			</p>
			<div class="flex flex-wrap justify-center gap-4 text-sm text-white/90 md:justify-start">
				<span class="rounded-full border border-wolves-gold/40 px-4 py-1.5 font-semibold">
					NPO {trustRegistration.npo}
				</span>
				<span class="rounded-full border border-wolves-gold/40 px-4 py-1.5 font-semibold">
					PBO {trustRegistration.pbo}
				</span>
				<span class="rounded-full border border-wolves-gold/40 px-4 py-1.5 font-semibold">
					NPC {trustRegistration.npc}
				</span>
			</div>
		</div>

		<div class="px-6 py-10 md:px-12 md:py-12">
			<h3 class="font-oswald mb-4 text-center text-2xl font-bold uppercase tracking-widest text-white md:text-3xl">
				Become a Sponsor
			</h3>
			<p class="mx-auto mb-10 max-w-3xl text-center text-lg text-white/80">
				Partner with Wolverhampton FC — Cape Town institution with 66+ years of history, CDFA
				affiliation, and measurable community outcomes. International partners receive transparent
				reporting and alignment with youth development and social impact goals.
			</p>

			<ul class="mx-auto mb-10 grid max-w-5xl gap-6 md:grid-cols-2">
				{
					fundingPriorities.map((fp) => (
						<li class="rounded-lg border border-white/10 bg-wolves-black/50 p-6 text-left">
							<p class="font-oswald text-lg font-semibold uppercase tracking-wide text-wolves-gold">
								{fp.title}
							</p>
							<p class="mt-2 text-2xl font-bold text-white">{fp.amountZar}</p>
							{fp.amountApproxGbp ? (
								<p class="text-sm text-white/60">{fp.amountApproxGbp} indicative</p>
							) : null}
							{fp.note ? <p class="mt-3 text-sm leading-relaxed text-white/75">{fp.note}</p> : null}
						</li>
					))
				}
			</ul>

			<div class="text-center">
				<a
					href="#contact"
					class="inline-block rounded-full bg-wolves-gold px-10 py-4 font-oswald text-base font-semibold uppercase tracking-widest text-wolves-black no-underline transition-all duration-300 hover:-translate-y-1 hover:bg-wolves-orange hover:shadow-[0_10px_30px_rgba(253,185,19,0.4)]"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</div>
</section>