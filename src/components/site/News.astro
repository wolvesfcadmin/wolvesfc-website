---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// Fetch the news items from Sanity, ordering the newest ones first
const newsItems = await sanityClient.fetch(`
  *[_type == "news"] | order(date desc) {
    title,
    date,
    excerpt,
    "imageSrc": image.asset->url,
    "emoji": emojiFallback
  }
`);

// Helper function updated to include the DAY
const formatDate = (dateString: string) => {
    if (!dateString) return '';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<section id="news" class="bg-wolves-black px-8 py-20 md:py-24">
	<SectionHeading title="Latest News" subtitle="Stay Updated" />
	<div class="mx-auto grid max-w-[87.5rem] gap-8 md:grid-cols-2 lg:grid-cols-3">
		{
			newsItems.map((item: any) => (
				<article class="group overflow-hidden rounded-xl border border-wolves-gold/10 bg-wolves-dark-gray transition-all duration-300 hover:-translate-y-2 hover:border-wolves-gold hover:shadow-[0_20px_40px_rgba(253,185,19,0.2)]">
					<div class="relative flex h-[200px] items-center justify-center overflow-hidden bg-gradient-to-br from-wolves-dark-gray to-wolves-black text-5xl after:absolute after:inset-0 after:bg-gradient-to-br after:from-transparent after:to-wolves-gold/10">
						{item.imageSrc ? (
							<img
								src={item.imageSrc}
								alt={item.title}
								class="relative z-[1] max-h-32 w-auto object-contain cursor-pointer transition-transform duration-300 hover:scale-110"
                                onclick={`openImageModal('${item.imageSrc}')`}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<span class="relative z-[1]" aria-hidden="true">
								{item.emoji || '⚽'}
							</span>
						)}
					</div>
					<div class="p-6">
						<div class="mb-3 text-sm uppercase tracking-wide text-wolves-gold">{formatDate(item.date)}</div>
						<h3 class="font-oswald mb-3 text-xl font-semibold leading-snug">{item.title}</h3>
						<p class="text-base leading-relaxed text-white/80">{item.excerpt}</p>
					</div>
				</article>
			))
		}
	</div>
	
    {/* IMAGE LIGHTBOX MODAL */}
    <div 
    	id="imageModal" 
    	class="fixed inset-0 z-[9999] hidden items-center justify-center bg-wolves-black/95 p-4 opacity-0 transition-opacity duration-300"
	>
        {/* Close Button */}
    	<button 
       		onclick="closeImageModal()" 
       		class="absolute right-6 top-6 text-5xl text-wolves-gold transition-transform hover:scale-110 hover:text-white focus:outline-none"
      		aria-label="Close modal"
   		>
        	&times;
        </button>
    
        {/* The Enlarged Image */}
    	<img 
        	id="modalImage" 
        	src="" 
        	alt="Enlarged view" 
        	class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-[0_0_50px_rgba(0,0,0,0.5)]" 
    	/>
	</div>
</section>

<script is:inline>
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');

    // Open the modal and set the image source
    function openImageModal(imgSrc) {
        modalImg.src = imgSrc;
        modal.classList.remove('hidden');
        modal.classList.add('flex'); // Switch to flex so it centers
        
        // Small delay to allow the browser to process the display change before fading in
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
        }, 10);
        
        // Lock background scrolling
        document.body.style.overflow = 'hidden';
    }

    // Close the modal
    function closeImageModal() {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        
        // Wait for the fade-out transition to finish before hiding it completely
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            modalImg.src = ''; // Clear out the image
        }, 300);
        
        // Restore background scrolling
        document.body.style.overflow = '';
    }

    // Bonus UX: Close the modal if the user clicks anywhere on the dark background
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            closeImageModal();
        }
    });
    
    // Bonus UX: Close the modal if the user presses the Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeImageModal();
        }
    });
</script>