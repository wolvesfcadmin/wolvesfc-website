---
import { sanityClient } from '../../lib/sanity';
import SectionHeading from './SectionHeading.astro';

// Fetch history blocks, ordering them by the displayOrder number you set in Sanity
const historyBlocks = await sanityClient.fetch(`
  *[_type == "history"] | order(displayOrder asc) {
    title,
    content
  }
`);
---

<section id="history" class="bg-wolves-dark-gray px-8 py-20 md:py-24">
	<SectionHeading title="Our History" subtitle="Decades on the Cape Flats" />
	
    <div class="mx-auto max-w-[87.5rem] space-y-12 text-lg leading-relaxed text-white/85">
        {historyBlocks.map((block: any) => (
            <div class="rounded-2xl border border-wolves-gold/20 bg-wolves-black/40 p-8 md:p-10">
                <h3 class="font-oswald mb-4 text-xl font-bold uppercase tracking-widest text-wolves-gold">
                    {block.title}
                </h3>
                <div 
                    class="leading-relaxed"
                    set:html={block.content ? block.content.replace(/\n/g, '<br />') : ''}
                />
            </div>
        ))}
	</div>
</section>